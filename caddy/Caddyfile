{
	email {$ACME_EMAIL}
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}

www.soulcuts.com.ua {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	handle /support-widget {
		reverse_proxy public-site:3000 {
			header_down -X-Frame-Options
		}
	}
	handle {
		header X-Frame-Options "DENY"
		redir https://soulcuts.com.ua{uri} 308
	}
}

soulcuts.com.ua {
	import security_headers
	encode zstd gzip

	header /robots.txt >Cache-Control "no-store"
	respond /support-widget 404

	redir /blog /blog/ 308

	@blog path /blog/*
	reverse_proxy @blog blog:3000 {
		header_down Referrer-Policy "strict-origin-when-cross-origin"
	}

	@private_booking path /booking /booking/*
	reverse_proxy @private_booking public-site:3000 {
		header_down Referrer-Policy "no-referrer"
	}

	reverse_proxy public-site:3000 {
		header_down Referrer-Policy "strict-origin-when-cross-origin"
	}
}

admin.soulcuts.com.ua {
	import security_headers
	encode zstd gzip
	reverse_proxy admin-app:3000 {
		header_down Referrer-Policy "strict-origin-when-cross-origin"
	}
}

api.soulcuts.com.ua {
	import security_headers
	encode zstd gzip
	reverse_proxy backend:8000 {
		header_down Referrer-Policy "strict-origin-when-cross-origin"
	}
}
