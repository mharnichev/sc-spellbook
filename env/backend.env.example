# Backend configuration reference, not a copy of production secrets.
# Keys are alphabetical within each section. Units are part of key names.
# Compose may override these values; inspect its environment section as well.
# Configure real credentials directly in /opt/soulcuts/env/backend.env, never Git.

# --- Application and public addresses ---
API_WORKERS=1
APP_ENV=production
APP_NAME=soulcuts-api
DEBUG=false
PUBLIC_API_BASE_URL=https://api.soulcuts.com.ua
PUBLIC_SITE_URL=https://soulcuts.com.ua

# --- HTTP security and trusted ingress ---
# Trust only the actual reverse proxy, not arbitrary forwarded client headers.
CORS_ORIGINS=https://soulcuts.com.ua,https://www.soulcuts.com.ua,https://admin.soulcuts.com.ua
TRUSTED_PROXY_IPS=172.30.41.2

# --- Authentication and session lifetime ---
# Replace the example signing secret before deployment.
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKOFFICE_REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_ACCESS_TOKEN_EXPIRE_DAYS=30
SECRET_KEY=change-me-use-a-long-random-secret

# --- Login OTP: code lifetime and abuse limits ---
OTP_CODE_TTL_MINUTES=10
OTP_MAX_SENDS_PER_DAY=3
OTP_MAX_VERIFY_ATTEMPTS_PER_DAY=5
OTP_RESEND_INTERVAL_SECONDS=120

# --- Database and migration policy ---
# An empty URL uses the POSTGRES_* settings supplied by the deployment.
# Production startup checks migrations; the release job applies them separately.
DATABASE_URL=
MIGRATIONS_MODE=check

# --- Background worker ownership and activity notifications ---
BACKGROUND_OWNER_HEARTBEAT_SECONDS=5
BACKGROUND_WORKERS_ENABLED=true
CUSTOMER_ACTIVITY_NOTIFICATION_SCHEDULER_ENABLED=true

# --- Error monitoring: Sentry ---
# Empty DSN disables initialization. Never commit a real project DSN here.
# Release is optional; use the deployed source SHA for error correlation.
# Trace sampling is a fraction (0..1); throttling is per process, in seconds.
SENTRY_DSN=
SENTRY_EVENT_THROTTLE_SECONDS=600
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- File storage: AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_SECRET_ACCESS_KEY=

# --- SMS transport and login message ---
# stub is the example provider, not a production sending configuration.
# Keep template placeholders intact; credentials and sender are provider-specific.
SMS_CLUB_BASE_URL=https://im.smsclub.mobi
SMS_CLUB_TOKEN=
SMS_OTP_TEMPLATE=Ваш код для входу в Soul Cuts: {code}. Нікому його не повідомляйте.
SMS_PROVIDER=stub
SMS_SENDER_NAME=Soul Cuts

# --- SMS delivery status polling ---
# Polling interval and the maximum age of messages eligible for status checks.
SMS_DELIVERY_STATUS_MAX_AGE_HOURS=48
SMS_DELIVERY_STATUS_POLL_INTERVAL_SECONDS=60
SMS_DELIVERY_STATUS_SCHEDULER_ENABLED=true

# --- Booking SMS: confirmation and two-hour reminders ---
# Notification/reminder switches are separate from the transport configuration.
# The reminder loop runs at INTERVAL_SECONDS; lead/window control visit selection.
BOOKING_SMS_CONFIRMATION_TEMPLATE=Ви записані до майстра {master_name} на {appointment_date} о {appointment_time}. Чекаємо у {barbershop_name}.
BOOKING_SMS_NOTIFICATIONS_ENABLED=false
BOOKING_SMS_REMINDERS_ENABLED=false
BOOKING_SMS_REMINDER_INTERVAL_SECONDS=300
BOOKING_SMS_TWO_HOUR_REMINDERS_ENABLED=true
BOOKING_SMS_TWO_HOUR_REMINDER_LEAD_HOURS=2
BOOKING_SMS_TWO_HOUR_REMINDER_TEMPLATE=Нагадуємо, сьогодні о {appointment_time} у вас візит до майстра {master_name}. Будемо раді бачити вас у {barbershop_name}.
BOOKING_SMS_TWO_HOUR_REMINDER_WINDOW_MINUTES=30

# --- Telegram bot and webhook ---
# Token authenticates API calls; webhook secret validates incoming requests.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SEND_TIMEOUT_SECONDS=10
TELEGRAM_WEBHOOK_SECRET=

# --- Email delivery: SMTP ---
# Use a verified sender; TLS and port must match the provider configuration.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Soulcuts
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_USE_TLS=true

# --- Google Business: credentials, location and review cache ---
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_REVIEWS_CACHE_TTL_DAYS=30
GOOGLE_BUSINESS_REVIEWS_MAX_PAGES=5
GOOGLE_BUSINESS_REVIEWS_ORDER_BY=updateTime desc
GOOGLE_BUSINESS_REVIEWS_PAGE_SIZE=50

# --- Nova Poshta: delivery API ---
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_TIMEOUT_SECONDS=10

# --- Product popularity and view retention ---
# Recalculation cadence, ranking window, thresholds and maximum result size.
PRODUCT_TOP_CHECK_INTERVAL_DAYS=7
PRODUCT_TOP_FRACTION=0.1
PRODUCT_TOP_MAX_PRODUCTS=8
PRODUCT_TOP_MIN_PAID_ORDERS=3
PRODUCT_TOP_MIN_UNIQUE_VIEWS=30
PRODUCT_TOP_REFRESH_INTERVAL_DAYS=30
PRODUCT_TOP_SCHEDULER_ENABLED=true
PRODUCT_TOP_WINDOW_DAYS=30
PRODUCT_VIEW_RETENTION_DAYS=90

# --- Shop access and operational features ---
# Keep the public checkout closed. Do not enable features to bypass pilot gates.
SHOP_CHECKOUT_ENABLED=false
SHOP_ORDER_OPERATIONS_ENABLED=false
SHOP_PAYMENT_RESOLUTIONS_ENABLED=false

# --- Shop payments, fiscal receipts and carrier returns ---
# Feature switches and live-provider transport switches are independent gates.
SHOP_CHECKBOX_ENABLED=false
SHOP_CHECKBOX_LIVE_TRANSPORT_ENABLED=false
SHOP_MONOBANK_LIVE_TRANSPORT_ENABLED=false
SHOP_NP_RETURNS_ENABLED=false
SHOP_NP_RETURN_LIVE_TRANSPORT_ENABLED=false
SHOP_PAYMENTS_ENABLED=false

# --- Sandbox, mock providers and simulation ---
# Keep production mock/sandbox flags disabled; never mix test and real operations.
CHECKBOX_ETTN_MOCK_ENABLED=false
CHECKBOX_MOCK_ENABLED=false
LOCAL_SALES_SIMULATION_ENABLED=false
MONOBANK_QR_MOCK_ENABLED=false
NP_MOCK_SHIPMENTS_ENABLED=false
PROVIDER_SANDBOX_ENABLED=false
SANDBOX_PROVIDER_NETWORK_ENABLED=false
SHOP_CARRIER_RETURNS_MOCK_ENABLED=false
SHOP_FISCAL_MOCK_ENABLED=false

# --- Carrier tracking scheduler ---
NP_TRACKING_ENABLED=false
